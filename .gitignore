import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.print("Въведете броя на студентите: ");
        int n = input.nextInt();
        input.nextLine();

        student[] student = new student[n];

        for (int i = 0; i < n; i++) {
            System.out.println("\nСтудент " + (i + 1));

            System.out.print("Име: ");
            String name = input.nextLine();

            System.out.print("Факултетен номер: ");
            String facultyNumber = input.nextLine();

            System.out.print("Оценка: ");
            double grade = input.nextDouble();
            input.nextLine();

            student[i] = new student(name, facultyNumber, grade);
        }

        input.close();
    }
}
